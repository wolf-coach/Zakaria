{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'omar@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'omar@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'omar@gmail.com')"
      }
    },
    "programs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'omar@gmail.com')",
        ".write": "auth != null && auth.token.email === 'omar@gmail.com'"
      }
    }
  }
}
